# Skopiuj ten plik do .env i uzupełnij wartości:  cp .env.example .env

# Port serwera (Render ustawia go automatycznie)
PORT=3000

# Hasło do panelu admina – ZMIEŃ NA WŁASNE
ADMIN_PASSWORD=zmien-mnie

# Origin(y) frontendu, po przecinku, BEZ ukośnika na końcu.
# Ukośnik na końcu psuje nagłówek Access-Control-Allow-Origin i blokuje uploady.
# Przykład: https://ale-animiec-v2.vercel.app,https://ale-animiec.vercel.app
FRONTEND_URL=

# Ustaw na 1, jeśli chcesz akceptować dowolny origin (np. podglądy deployów Vercel).
# Gdy FRONTEND_URL jest puste, i tak dozwolone są wszystkie originy.
ALLOW_ANY_ORIGIN=0

# Maksymalny rozmiar wgrywanego pliku w GB
MAX_UPLOAD_GB=4
